# ==========================================================
# ULTIMATE RAG PIPELINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================

# ----------------------------------------------------------
# 1. Primary AI Provider: Google Gemini API Key
# Used for:
# - Stage 6: Dense Embeddings (models/text-embedding-004)
# - Stage 14: LLM Generation (gemini-1.5-flash / gemini-2.0-flash)
# Get your key at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ----------------------------------------------------------
# 2. Vector Database Engine
# Used for:
# - Stage 7: Local Vector Store Indexing (ChromaDB / FAISS)
# No cloud keys needed! Indexed locally in-memory / disk.
# ----------------------------------------------------------
VECTOR_STORE_ENGINE=ChromaDB_FAISS

# ----------------------------------------------------------
# 3. Reranker Engine
# Used for:
# - Stage 12.3: Multi-Feature Cross-Encoder Reranking
# Applied via Custom Python Code (No Cohere API key required!)
# ----------------------------------------------------------
RERANKER_ENGINE=Custom_CrossEncoder

# ----------------------------------------------------------
# 4. Optional Secondary Provider: OpenAI API Key
# ----------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# NOTE: If no API keys are supplied, the pipeline automatically operates in 
# 100% offline mode using high-performance local deterministic models!
